{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the settings window and the menu bar popover",
  "windows": [
    "main",
    "popover"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "dialog:default",
    "fs:default",
    "autostart:default",
    "updater:default",
    "process:default"
  ]
}
